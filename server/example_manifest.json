{
  "slug": "test-extension",
  "name": "Test Extension",
  "version": "1.0.0",
  "description": "Example extension for testing the manifest system",
  "author": "LifeLog Team",
  "server_side": {
    "actors": [
      {
        "slug": "test-source",
        "type": "SOURCE",
        "version": "1.0.0",
        "description": "Test data source"
      },
      {
        "slug": "test-processor",
        "type": "PROCESSOR",
        "version": "1.0.0",
        "description": "Processes test data into test events"
      }
    ],
    "event_types": [
      {
        "slug": "test-event",
        "description": "A test event type"
      }
    ],
    "prompt_templates": [
      {
        "slug": "test-prompt",
        "description": "Example prompt for testing",
        "template_text": "Process this data: {{data}}",
        "version": 1
      }
    ]
  },
  "client_side": {
    "platforms": {
      "macos": {
        "collectors": [
          {
            "slug": "test-collector",
            "entrypoint": "collector.js"
          }
        ],
        "ui_components": [
          {
            "slug": "test-widget",
            "type": "dashboard-widget",
            "name": "Test Summary Widget",
            "component": "widgets/TestSummary.html",
            "permissions": {
              "data_read": ["self.events", "self.synthesis_reports"],
              "network_access": []
            }
          }
        ]
      }
    }
  },
  "config": {
    "example_setting": "example_value"
  }
}
