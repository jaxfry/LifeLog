# PostgreSQL Database Configuration
POSTGRES_USER=lifelog
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=lifelog_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application Configuration
# The full connection string used by the Python app
DATABASE_URL=postgresql://lifelog:supersecretpassword@db:5432/lifelog_db

# Set to "development" for local work, "production" for deployments
APP_ENV=development

# A secret key for signing tokens, etc.
# Generate a new one for production with: openssl rand -hex 32
SECRET_KEY=a-very-bad-and-insecure-secret-for-dev