# LifeLog Configuration

# --- Server ---
SECRET_KEY=change-this-to-a-random-secret-key
LOG_LEVEL=INFO
DEBUG=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://lifelog:lifelogpassword@localhost:5432/lifelog_db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- CORS ---
ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI (at least one required for enrichment) ---
# Hack Club AI (primary, recommended)
HACK_CLUB_AI_API_KEY=

# Google Gemini (fallback)
GEMINI_API_KEY=
