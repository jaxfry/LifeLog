# LifeLog Configuration

# --- Server ---
SECRET_KEY=change-this-to-a-random-secret-key
LOG_LEVEL=INFO
DEBUG=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://lifelog:lifelogpassword@localhost:5432/lifelog_db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- CORS ---
ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI (at least one required for enrichment) ---
# OpenRouter (primary)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ASSISTANT_MODEL=deepseek/deepseek-v4-flash
ASSISTANT_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT_SECONDS=90
# AI_DAILY_BUDGET_USD=5
# Assign models by capability. Blank text roles inherit ASSISTANT_MODEL.
GENERAL_MODEL=
VISION_MODEL=
EXTRACTION_MODEL=
RESOLUTION_MODEL=
SUMMARY_MODEL=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=768
RERANK_MODEL=
TRANSCRIPTION_MODEL=whisper-1

# Hack Club AI (optional fallback and embeddings)
HACK_CLUB_AI_API_KEY=
HACK_CLUB_AI_BASE_URL=https://ai.hackclub.com/proxy/v1

# Google Gemini (fallback)
GEMINI_API_KEY=
